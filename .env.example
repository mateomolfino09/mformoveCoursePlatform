NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_YOUTUBE_API_KEY=
# Link de la comunidad MMove | Comunidad de Movimiento (usado en toda la app si no se define)
NEXT_PUBLIC_WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/LgVResfArGjIn9qByXXUSo
# Opcional: URL wa.me chat directo (ej. MoveCrew). Si falta se usa número por defecto en el código.
# NEXT_PUBLIC_MOVECREW_WA_CHAT=https://wa.me/TUNUMERO?text=...

MONGODB_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

EMAIL_FROM=

NEXTAUTH_SECRET=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

NEXT_PUBLIC_TIME_COURSE_SAVE=

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_SITE_KEY=

MERCADO_PAGO_PUBLIC_API_KEY=

# Stripe (pagos de cursos y membresías)
STRIPE_SECRET_KEY=
# Secret que muestra `stripe listen` al desarrollar en local:
STRIPE_WEBHOOK_SECRET_PAYMENTS_STRIPE_WEBHOOK=
# Webhook de productos/eventos (/api/webhooks/stripe) en producción:
STRIPE_WEBHOOK_SECRET_WEBHOOKS_STRIPE=
# Fallback opcional si usás un solo endpoint:
# STRIPE_WEBHOOK_SECRET=

# Suscripción manual en producción (solo si usas POST /api/payments/createManualSubscription con isProd: true)
# Nunca subas valores reales a Git; configurar en el servidor o en .env local (no versionado).
# MONGODB_URI_PRODUCTION=
# MANUAL_SUB_PROD_TEMPLATE_SUB_ID=
# MANUAL_SUB_PROD_TEMPLATE_PLAN_ID=
# MANUAL_SUB_PROD_TEMPLATE_SUBSCRIPTION_TOKEN=
# MANUAL_SUB_PROD_TEMPLATE_PAYMENT_METHOD_CODE=
# MANUAL_SUB_PROD_TEMPLATE_CLIENT_ID=

# --- Publicación legal (mismos datos que en dLocal Go; visibles en /terminos) ---
# Persona física en dLocal:
# NEXT_PUBLIC_LEGAL_ADMIN_NAME=
# NEXT_PUBLIC_LEGAL_ADMIN_DOC=
# NEXT_PUBLIC_LEGAL_ADMIN_EMAIL=
# Persona jurídica en dLocal (no uses las dos líneas PF a la vez con PJ):
# NEXT_PUBLIC_LEGAL_COMPANY_NAME=
# NEXT_PUBLIC_LEGAL_TAX_ID=
# Teléfono visible en el pie (opcional; si omitís y hay wa.me en MOVECREW, se muestra igual):
# NEXT_PUBLIC_SITE_PHONE_DISPLAY=

